<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">
  <Id>931f421a-3efa-48bd-906a-dc3182d38f5b</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>Ask GPT</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="Ask GPT 写作助手" />
  <Description DefaultValue="检查当前页面的拼写，选择句子润色，并逐处接受保留格式的修改。" />
  <SupportUrl DefaultValue="https://localhost:43793/shared/taskpane.html?host=word" />
  <AppDomains><AppDomain>https://localhost:43793</AppDomain></AppDomains>
  <Hosts><Host Name="Document" /></Hosts>
  <Requirements><Sets DefaultMinVersion="1.3"><Set Name="WordApi" MinVersion="1.3" /></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://localhost:43793/shared/taskpane.html?host=word" /></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="SharedRuntime" MinVersion="1.1" /><bt:Set Name="AddinCommands" MinVersion="1.1" /></bt:Sets></Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <Runtimes><Runtime resid="Taskpane.Url" lifetime="long" /></Runtimes>
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AskGPT.WritingGroup">
                <Label resid="Writing.Label" />
                <Icon><bt:Image size="16" resid="Writing.Icon" /><bt:Image size="32" resid="Writing.Icon" /><bt:Image size="80" resid="Writing.Icon" /></Icon>
                <Control xsi:type="Button" id="AskGPT.WritingOpen">
                  <Label resid="Writing.Label" />
                  <Supertip><Title resid="Writing.Label" /><Description resid="Writing.Description" /></Supertip>
                  <Icon><bt:Image size="16" resid="Writing.Icon" /><bt:Image size="32" resid="Writing.Icon" /><bt:Image size="80" resid="Writing.Icon" /></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images><bt:Image id="Writing.Icon" DefaultValue="https://localhost:43793/word/icon.png" /></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://localhost:43793/shared/taskpane.html?host=word" /></bt:Urls>
      <bt:ShortStrings><bt:String id="Writing.Label" DefaultValue="写作" /></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Writing.Description" DefaultValue="拼写检查与选句润色。" /></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
