{
  "manifest_version": 3,
  "name": "Ask for GPT Inline",
  "version": "1.1.2",
  "minimum_chrome_version": "106",
  "description": "Translate web pages and preserve PDF layout in the current tab, using Ask for GPT.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43792/*",
    "http://127.0.0.1:43795/*"
  ],
  "optional_host_permissions": [
    "file:///*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' blob:;"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Translate / Restore · ⌥⇧X"
  },
  "commands": {
    "toggle-inline": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Translate / Restore"
    }
  }
}
