}
(async () => {
  for (const file of ['service-worker.js', 'content.js', 'pdf-core.js', 'pdf-worker.js', 'pdf-reader.js']) {
    const result = spawnSync(process.execPath, ['--check', path.join(browser, file)], { encoding: 'utf8' });
    assert.equal(result.status, 0, result.stderr);
  }
  const der = Buffer.from(manifest.key, 'base64');
  const derived = [...crypto.createHash('sha256').update(der).digest().subarray(0, 16)]
    .map(byte => String.fromCharCode(97 + (byte >> 4), 97 + (byte & 15))).join('');
  assert.equal(derived, identity.chromeExtensionID);
  assert.deepEqual(manifest.permissions, ['activeTab', 'scripting', 'storage']);
  assert.deepEqual(manifest.host_permissions, ['http://127.0.0.1:43792/*', 'http://127.0.0.1:43795/*']);
  assert.deepEqual(manifest.optional_host_permissions, ['file:///*']);
  assert(!manifest.web_accessible_resources); assert(!fs.existsSync(path.join(browser, 'connection.local.json')));
  assert(!contentSource.includes('innerHTML')); assert(!contentSource.includes('connection.local.json'));
  checks.manifest_stable_identity_minimal_permissions_no_real_token_and_syntax = true;
  await workerChecks();
  let JSDOM;
  try { ({ JSDOM } = require(path.join(root, 'work/browser-inline-test/node_modules/jsdom'))); }
  catch { throw new Error('Test-only jsdom missing. Install the pinned work/browser-inline-test dependency; product has no npm dependency.'); }
  await domChecks(JSDOM);
  process.stdout.write(JSON.stringify({ status: 'PASS', checks, extensionID: derived, fixtureOnly: true }, null, 2) + '\n');
})().catch(error => {
  process.stdout.write(JSON.stringify({ status: 'FAIL', checks, error: error.message, stack: error.stack }, null, 2) + '\n');
  process.exitCode = 1;
});
