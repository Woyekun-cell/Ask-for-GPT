      const nestedDocument = nestedScroll.window.document;
      const rect = (top, bottom, left = 0, right = 300) => ({ top, bottom, left, right, width: right - left, height: bottom - top });
      const setSize = (id, values) => {
        for (const [name, value] of Object.entries(values)) Object.defineProperty(nestedDocument.querySelector(id), name, { configurable: true, value });
      };
      setSize('#outer-scroll', { clientHeight: 768, scrollHeight: 2000 });
