#!/usr/bin/env node
'use strict';
// Synthetic JSDOM + mocked Chrome APIs only. Never launches Chrome, reads user
// pages, loads an extension, or uses the exported local pairing token.
const fs = require('node:fs');
const path = require('node:path');
const vm = require('node:vm');
const assert = require('node:assert/strict');
const crypto = require('node:crypto');
const { spawnSync } = require('node:child_process');
const root = path.resolve(__dirname, '..');
const browser = path.join(root, 'Integrations/Browser');
const identity = JSON.parse(fs.readFileSync(path.join(root, 'Integrations/identity.json'), 'utf8'));
const manifest = JSON.parse(fs.readFileSync(path.join(browser, 'manifest.json'), 'utf8'));
const contentSource = fs.readFileSync(path.join(browser, 'content.js'), 'utf8');
const workerSource = fs.readFileSync(path.join(browser, 'service-worker.js'), 'utf8');
const SECRET = 'synthetic_test_pairing_token_12345678901234567890';
const ENDPOINT = 'http://127.0.0.1:43792/v1/inline/translate';
const checks = {};
const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
async function until(condition, message, timeout = 4000) {
  const deadline = Date.now() + timeout;
  while (Date.now() < deadline) { if (await condition()) return; await wait(5); }
  throw new Error(message);
}
function event() { let callback; return { addListener(value) { callback = value; }, fire(...args) { return callback?.(...args); } }; }
function workerHarness(options = {}) {
  const values = {}, calls = [], deliveries = [], outputs = [];
  const tab = { id: 7, active: true, url: 'https://fixture.test/paper' };
  const tabs = new Map([[tab.id, tab]]);
  const events = { message: event(), action: event(), command: event(), removed: event(), updated: event(), activated: event() };
  const chrome = {
    runtime: { id: identity.chromeExtensionID, getURL: name => `chrome-extension://${identity.chromeExtensionID}/${name}`, onMessage: events.message },
    storage: { session: {
      async get(key) { return key == null ? structuredClone(values) : { [key]: structuredClone(values[key]) }; },
      async set(next) { Object.assign(values, structuredClone(next)); },
      async remove(key) { delete values[key]; }
    } },
    tabs: { async get(id) { if (!tabs.has(id)) throw new Error('No such tab'); return { ...tabs.get(id) }; }, async query() { return [{ ...tab }]; },
      async sendMessage(id, message, target) { deliveries.push({ id, message, target }); return { ok: true, supported: true }; },
      onRemoved: events.removed, onUpdated: events.updated, onActivated: events.activated },
    scripting: { async executeScript(input) {
      await options.inject?.(tabs.get(input.target.tabId));
      return [{ frameId: 0, documentId: 'doc-' + input.target.tabId }];
    } },
    action: { onClicked: events.action, async setBadgeText() {}, async setTitle() {} },
    commands: { onCommand: events.command }
  };
  const configuration = { version: 1, endpoint: 'http://127.0.0.1:43792', token: SECRET,
    extensionID: identity.chromeExtensionID, ...options.configuration };
  async function fetchFixture(url, init = {}) {
    if (url.endsWith('/connection.local.json')) return new Response(JSON.stringify(configuration), { status: 200 });
    const body = JSON.parse(init.body);
    calls.push({ url, init, body });
    const output = outputs.shift();
    if (typeof output === 'function') return output(url, init, body);
    return new Response(JSON.stringify(output?.body || { id: body.id, translation: '译文 0.05' }), { status: output?.status || 200 });
  }
  const context = vm.createContext({ chrome, fetch: fetchFixture, URL, AbortController, setTimeout, clearTimeout,
    crypto: crypto.webcrypto, console: { log() { throw new Error('worker must not log'); }, error() { throw new Error('worker must not log'); } } });
  context.importScripts = (...names) => names.forEach(name => vm.runInContext(fs.readFileSync(path.join(browser, name), 'utf8'), context, { filename: name }));
  vm.runInContext(workerSource, context, { filename: 'service-worker.js' });
  const sender = { id: identity.chromeExtensionID, tab: { id: tab.id }, frameId: 0, documentId: 'doc-7', url: tab.url };
  function request(message, overrides = {}) {
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error('worker message did not terminate')), 3000);
      const accepted = events.message.fire(message, { ...sender, ...overrides }, response => { clearTimeout(timer); resolve(response); });
      if (!accepted) { clearTimeout(timer); resolve(null); }
    });
  }
  async function start(target = tab) {
    events.action.fire(target);
    await until(() => deliveries.some(value => value.id === target.id && value.message.type === 'INLINE_START'), 'worker did not start injected session');
    return values['askgpt.inline.' + target.id];
  }
  function translation(session, extra = {}) {
    return { type: 'INLINE_TRANSLATE', sessionId: session.id, id: 'fixture-1', text: 'The response was not significant (P > 0.05).', source: 'en', target: 'zh-Hans', ...extra };
  }
  return { values, tab, tabs, events, calls, deliveries, outputs, request, start, translation };
}
function heldFetch(_url, init) {
  return new Promise((_resolve, reject) => {
    if (init.signal.aborted) reject(new DOMException('Aborted', 'AbortError'));
    else init.signal.addEventListener('abort', () => reject(new DOMException('Aborted', 'AbortError')), { once: true });
  });
}
async function workerChecks() {
  const harness = workerHarness();
  const noSession = await harness.request(harness.translation({ id: 'invented' }));
  assert.equal(noSession.code, 'INACTIVE'); assert.equal(harness.calls.length, 0);
  const active = await harness.start();
  for (const sender of [{ id: 'another-extension' }, { documentId: 'old-document' }, { frameId: 1 }, { tab: undefined }]) {
    assert.equal((await harness.request(harness.translation(active), sender)).code, 'INACTIVE');
  }
  for (const extra of [{ id: 'x'.repeat(81) }, { text: '😀'.repeat(1801) }, { source: 'auto' }, { target: 'en' }, { text: '' }]) {
    assert.equal((await harness.request(harness.translation(active, extra))).code, 'INVALID');
  }
  assert.equal(harness.calls.length, 0);
  checks.worker_sender_session_document_and_payload_guards = true;
  const inactive = workerHarness(); inactive.tab.active = false; inactive.events.action.fire(inactive.tab); await wait(20);
  assert.equal(inactive.deliveries.length, 0); assert.equal(Object.keys(inactive.values).length, 0);
  checks.worker_initial_inactive_tab_cannot_authorize_translation = true;
  const switching = workerHarness({ inject(target) { target.active = false; } });
  const switched = await switching.start();
  assert.equal((await switching.request(switching.translation(switched))).ok, true);
  const replacing = workerHarness({ inject(target) { target.url = 'https://fixture.test/new-document'; } });
  replacing.events.action.fire({ ...replacing.tab }); await wait(20);
  assert.equal(Object.keys(replacing.values).length, 0);
  assert(!replacing.deliveries.some(value => value.message.type === 'INLINE_START'));
  checks.worker_focus_move_during_injection_keeps_authorization_but_document_navigation_does_not = true;
  const background = workerHarness(), first = await background.start();
  const second = { id: 8, active: true, url: 'https://fixture.test/second' }; background.tabs.set(second.id, second);
  let releaseFirst;
  background.outputs.push((_url, init, body) => new Promise((resolve, reject) => {
    releaseFirst = () => resolve(new Response(JSON.stringify({ id: body.id, translation: 'First document' })));
    init.signal.addEventListener('abort', () => reject(new DOMException('Aborted', 'AbortError')), { once: true });
  }));
  const firstRequest = background.request(background.translation(first));
  await until(() => releaseFirst, 'background first document did not start');
  background.tab.active = false; background.events.activated.fire({ tabId: second.id });
  const secondSession = await background.start(second);
  background.outputs.push(heldFetch);
  const secondSender = { tab: { id: second.id }, documentId: 'doc-8', url: second.url };
  const secondRequest = background.request(background.translation(secondSession), secondSender);
  await until(() => background.calls.length === 2, 'second independent document did not start');
  await background.request({ type: 'INLINE_CONTROL', sessionId: secondSession.id, action: 'pause' }, secondSender);
  assert.equal((await secondRequest).code, 'CANCELLED');
  releaseFirst(); assert.equal((await firstRequest).ok, true);
  assert.equal(background.values['askgpt.inline.7'].paused, false);
  assert.equal(background.values['askgpt.inline.8'].paused, true);
  assert(!background.deliveries.some(value => value.id === 7 && value.message.type === 'INLINE_PAUSE'));
  assert.equal((await background.request(background.translation(first, { id: 'background-next' }))).ok, true);
  background.events.updated.fire(7, { url: 'https://fixture.test/replaced' }, { ...background.tab, url: 'https://fixture.test/replaced' });
  await until(() => !background.values['askgpt.inline.7'], 'background navigation did not revoke its document');
  assert.equal((await background.request(background.translation(first))).code, 'INACTIVE');
  assert(background.values['askgpt.inline.8']);
  checks.worker_authorized_tabs_continue_independently_and_stop_or_navigation_only_retires_owner = true;
  const success = await harness.request(harness.translation(active));
  assert.equal(success.ok, true); assert.equal(harness.calls.length, 1);
  assert.equal(harness.calls[0].url, ENDPOINT);
  assert.deepEqual(Object.keys(harness.calls[0].body).sort(), ['id', 'source', 'target', 'text']);
  assert.equal(harness.calls[0].init.headers.Authorization, 'Bearer ' + SECRET);
  assert(!JSON.stringify(success).includes(SECRET)); assert(!JSON.stringify(harness.deliveries).includes(SECRET));
  checks.worker_fixed_endpoint_private_token_and_minimal_response = true;
  harness.outputs.push(heldFetch);
  const pending = harness.request(harness.translation(active, { id: 'cancel-me' }));
  await until(() => harness.calls.length === 2, 'held request did not start');
  await harness.request({ type: 'INLINE_CONTROL', sessionId: active.id, action: 'cancel-block', id: 'cancel-me' });
  assert.equal((await pending).code, 'CANCELLED');
  harness.outputs.push(heldFetch);
  const paused = harness.request(harness.translation(active, { id: 'pause-me' }));
  await until(() => harness.calls.length === 3, 'pause request did not start');
  await harness.request({ type: 'INLINE_CONTROL', sessionId: active.id, action: 'pause' });
  assert.equal((await paused).code, 'CANCELLED');
  assert.equal((await harness.request(harness.translation(active))).code, 'INACTIVE');
  await harness.request({ type: 'INLINE_CONTROL', sessionId: active.id, action: 'resume' });
  assert.equal((await harness.request(harness.translation(active))).ok, true);
  checks.worker_block_cancel_pause_resume_abort_fetches = true;
  harness.outputs.push(heldFetch);
  const navigating = harness.request(harness.translation(active, { id: 'navigation' }));
  await until(() => harness.calls.length === 5, 'navigation request did not start');
  harness.events.updated.fire(7, { status: 'loading' }, harness.tab);
  assert.equal((await navigating).code, 'CANCELLED');
  await until(() => Object.keys(harness.values).length === 0, 'navigation did not revoke session');
  checks.worker_navigation_revokes_session_and_aborts_fetch = true;
  const restored = workerHarness(); const restoreSession = await restored.start();
  restored.outputs.push(heldFetch);
  const restoring = restored.request(restored.translation(restoreSession));
  await until(() => restored.calls.length === 1, 'restore request did not start');
  await restored.request({ type: 'INLINE_CONTROL', sessionId: restoreSession.id, action: 'restore' });
  assert.equal((await restoring).code, 'CANCELLED'); assert.equal(Object.keys(restored.values).length, 0);
  checks.worker_restore_revokes_and_cancels = true;
  const retry = workerHarness(); const retrySession = await retry.start();
  retry.outputs.push(...Array.from({ length: 3 }, () => ({ status: 503, body: { error: { code: 'translation_busy' } } })));
  assert.equal((await retry.request(retry.translation(retrySession))).code, 'BUSY'); assert.equal(retry.calls.length, 3);
  retry.outputs.push({ status: 503, body: { error: { code: 'native_unavailable' } } });
  assert.equal((await retry.request(retry.translation(retrySession))).code, 'NATIVE_UNAVAILABLE'); assert.equal(retry.calls.length, 4);
  retry.outputs.push({ status: 502, body: { error: { code: 'translation_failed' } } });
  assert.equal((await retry.request(retry.translation(retrySession))).code, 'FAILED'); assert.equal(retry.calls.length, 5);
  checks.worker_busy_retry_is_bounded_and_unavailable_is_not_retried = true;
  const badConfig = workerHarness({ configuration: { endpoint: 'https://not-allowed.invalid' } });
  const badSession = await badConfig.start();
  assert.equal((await badConfig.request(badConfig.translation(badSession))).code, 'UNPAIRED');
  assert.equal(badConfig.calls.length, 0);
  checks.worker_rejects_nonlocal_configuration = true;
  const reverse = workerHarness(); const reverseSession = await reverse.start();
  for (const pair of [{ source: 'zh', target: 'en' }, { source: 'zh-Hans', target: 'zh-Hans' },
    { source: 'en', target: 'en' }, { source: 'auto', target: 'en' }]) {
    assert.equal((await reverse.request(reverse.translation(reverseSession, pair))).code, 'INVALID');
  }
  assert.equal(reverse.calls.length, 0);
  const reverseResult = await reverse.request(reverse.translation(reverseSession,
    { text: '处理组没有增加，剂量为 3 mg。', source: 'zh-Hans', target: 'en' }));
  assert.equal(reverseResult.ok, true);
  assert.deepEqual(reverse.calls[0].body, { id: 'fixture-1', text: '处理组没有增加，剂量为 3 mg。', source: 'zh-Hans', target: 'en' });
  assert(!JSON.stringify(reverseResult).includes(SECRET));
  checks.worker_exact_bidirectional_pairs_forward_source_and_target_without_token_leak = true;
}
async function domChecks(JSDOM) {
  const environments = [];
  function fixture(html, handler, options = {}) {
    const dom = new JSDOM(html, { url: 'https://fixture.test/paper', runScripts: 'outside-only', pretendToBeVisual: true });
    environments.push(dom);
    const window = dom.window, roots = new Map(), calls = [], controls = [], listeners = [];
    const originalAttach = window.Element.prototype.attachShadow;
    window.Element.prototype.attachShadow = function (options) { const value = originalAttach.call(this, options); roots.set(this, value); return value; };
    const preferences = options.preferences || {}, preferenceWrites = [];
    window.chrome = { storage: { local: {
      get(key, callback) {
        if (options.readPreference) options.readPreference(key, callback);
        else queueMicrotask(() => callback({ [key]: preferences[key] }));
      },
      set(values, callback) { Object.assign(preferences, values); preferenceWrites.push({ ...values }); queueMicrotask(callback); }
    } }, runtime: { id: identity.chromeExtensionID, onMessage: { addListener(listener) { listeners.push(listener); } },
      sendMessage(message, callback) {
        if (message.type === 'INLINE_CONTROL') { controls.push(message); queueMicrotask(() => callback({ ok: true })); return; }
        calls.push(message);
        if (handler) handler(message, callback);
        else queueMicrotask(() => callback({ ok: true, id: message.id, translation: '中文：' + message.text }));
      } } };
    window.eval(contentSource);
    function send(value, sender = { id: identity.chromeExtensionID }) { let response; listeners[0](value, sender, result => { response = result; }); return response; }
    function start() { return send({ type: 'INLINE_START', sessionId: 'synthetic-session' }); }
    const translations = () => [...window.document.querySelectorAll('askgpt-inline-translation')].map(host => roots.get(host).querySelector('div').textContent);
    const bar = () => roots.get(window.document.querySelector('askgpt-inline-controls'));
    function click(name) {
      const action = { '停止': 'pause', '继续': 'resume', '恢复原文': 'restore', '方向': 'direction' }[name] || name;
      const button = [...bar().querySelectorAll('button')].find(button => button.dataset.action === action || button.dataset.color === name);
      assert(button, 'missing toolbar action ' + name); button.click();
    }
    const translatedElements = () => [...window.document.querySelectorAll('askgpt-inline-translation')].map(host => roots.get(host).querySelector('div'));
    return { window, calls, controls, roots, listeners, send, start, translations, translatedElements, bar, click, preferences, preferenceWrites };
  }
  try {
    const layouts = fixture(`<main><section id="grid" style="display:grid;grid-template-columns:1fr 1fr">
      <p id="grid-a">Grid original alpha.</p><p id="grid-b">Grid original beta.</p></section>
      <section id="flex" style="display:flex"><p id="flex-a" style="display:flex;height:20px;max-height:20px;overflow:hidden">Flex original alpha.</p><p id="flex-b">Flex original beta.</p></section>
      <ul><li id="list-a">List original alpha.</li><li id="list-b">List original beta.</li></ul>
      <table><tbody><tr><td id="cell-a">Cell original alpha.</td><td id="cell-b">Cell original beta.</td></tr></tbody></table>
      <section style="column-count:2"><p id="columns-a">Column original alpha.</p><p id="columns-b">Column original beta.</p></section>
      <p id="inner-columns" style="column-count:2">Paragraph columns original alpha.</p></main>`);
    const layoutDocument = layouts.window.document;
    const layoutOriginal = layoutDocument.querySelector('main').outerHTML;
    const layoutNodes = [...layoutDocument.querySelectorAll('p,li,td')];
    let clicked = 0; layoutNodes[0].addEventListener('click', () => clicked++);
    layouts.start(); await until(() => layouts.translations().length === layoutNodes.length, 'layout fixture did not translate');
    for (const source of layoutNodes) {
      const host = source.querySelector('askgpt-inline-translation');
      assert(host, source.id + ' translation must be contained in its original layout item');
      assert.equal(source.lastElementChild, host, source.id + ' translation must follow the original inside one item');
      assert.equal(layouts.roots.get(host).querySelector('div').textContent, '中文：' + source.firstChild.textContent);
    }
    assert.equal(layoutDocument.querySelector('#grid').children.length, 2);
    assert.equal(layoutDocument.querySelector('#flex').children.length, 2);
    assert.equal(layoutDocument.querySelector('ul').children.length, 2);
    assert.equal(layoutDocument.querySelector('tr').children.length, 2);
    assert.equal(layoutDocument.querySelector('#flex-a').style.display, 'block');
    assert.equal(layoutDocument.querySelector('#flex-a').style.height, 'auto');
    assert.equal(layoutDocument.querySelector('#flex-a').style.maxHeight, 'none');
    assert.equal(layoutDocument.querySelector('#flex-a').style.overflowX, 'visible');
    assert.equal(layoutDocument.querySelector('#inner-columns').style.columnCount, 'auto');
    layoutNodes[0].click(); assert.equal(clicked, 1);
    layouts.click('恢复原文');
    assert.equal(layoutDocument.querySelector('main').outerHTML, layoutOriginal);
    checks.dom_grid_flex_list_table_columns_keep_each_original_and_translation_in_one_item_and_restore = true;
    const moving = fixture('<main><section id="left"><p id="moving-a">Moving original alpha.</p><p id="moving-b">Moving original beta.</p></section><section id="right" style="display:grid"></section></main>');
    const movingDocument = moving.window.document;
    moving.start(); await until(() => moving.translations().length === 2, 'moving fixture missing translations');
    const movingA = movingDocument.querySelector('#moving-a'), movingB = movingDocument.querySelector('#moving-b');
    const movingHost = movingA.querySelector('askgpt-inline-translation');
    movingDocument.querySelector('#right').append(movingA);
    await wait(180); assert.equal(movingA.lastElementChild, movingHost);
    movingHost.remove();
    await until(() => movingA.lastElementChild === movingHost, 'removed translation was not repaired under its original');
    movingB.append(movingHost);
    await until(() => movingA.lastElementChild === movingHost, 'misplaced translation was not reclaimed by its original');
    const movingCalls = moving.calls.length; await wait(300);
    assert.equal(moving.calls.length, movingCalls); assert.equal(movingCalls, 2);
    assert.equal(moving.translations().length, 2);
    moving.click('恢复原文');
    assert.equal(movingA.parentElement.id, 'right', 'restoring must keep the site\'s own node movement');
    assert.equal(movingA.hasAttribute('style'), false);
    checks.dom_moved_original_carries_translation_removed_or_misplaced_hosts_repair_without_retranslation = true;
    let movedReply;
    const pendingMove = fixture('<main><section id="pending-left"><p id="pending-move">Pending source moves before response.</p></section><section id="pending-right" style="display:flex"></section></main>', (message, callback) => {
      movedReply = () => callback({ ok: true, id: message.id, translation: '移动后的对应译文。' });
    });
    pendingMove.start(); await until(() => movedReply, 'pending move request missing');
    const pendingSource = pendingMove.window.document.querySelector('#pending-move');
    pendingMove.window.document.querySelector('#pending-right').append(pendingSource); movedReply();
    await until(() => pendingMove.translations().length === 1, 'moved pending translation missing');
    assert.equal(pendingSource.lastElementChild.tagName, 'ASKGPT-INLINE-TRANSLATION');
    assert.equal(pendingSource.parentElement.children.length, 1);
    assert.equal(pendingMove.calls.length, 1);
    checks.dom_pending_source_reparenting_attaches_result_at_current_source_location = true;
    const siteStyles = fixture('<main><p id="site-style" style="height:20px;color:navy;overflow-x:clip">Site style updates remain after restore.</p></main>');
    siteStyles.start(); await until(() => siteStyles.translations().length === 1, 'site style fixture missing');
    const siteSource = siteStyles.window.document.querySelector('#site-style');
    siteSource.style.setProperty('height', '99px'); siteSource.style.setProperty('width', '70%');
    siteSource.style.setProperty('color', 'purple');
    await until(() => siteSource.style.height === 'auto', 'updated source did not preserve downward flow');
    siteStyles.click('恢复原文');
    assert.equal(siteSource.style.height, '99px'); assert.equal(siteSource.style.width, '70%');
    assert.equal(siteSource.style.color, 'purple'); assert.equal(siteSource.style.overflowX, 'clip');
    assert.equal(siteSource.style.overflowY, '');
    checks.dom_restore_preserves_site_inline_updates_and_original_overflow_longhands = true;
    let unsupportedReply;
    const positioning = fixture('<main><p id="supported">Ordinary supported paragraph.</p><p style="position:absolute">Absolute source must remain unchanged.</p><p style="writing-mode:vertical-rl">Vertical source must remain unchanged.</p></main>', (message, callback) => {
      unsupportedReply = () => callback({ ok: true, id: message.id, translation: '不应插入绝对定位的段落。' });
    });
    positioning.start(); await until(() => unsupportedReply, 'positioning fixture missing request');
    positioning.window.document.querySelector('#supported').style.position = 'absolute'; unsupportedReply();
    await wait(180); assert.equal(positioning.calls.length, 1); assert.equal(positioning.translations().length, 0);
    checks.dom_absolute_fixed_vertical_sources_are_kept_original_and_late_layout_changes_reject_results = true;
    const clipped = fixture('<main><section id="clip" style="height:20px;overflow-x:hidden;overflow-y:hidden"><p id="clip-source">A clipped card must not display a cut-off translation.</p></section></main>');
    const clipDocument = clipped.window.document;
    const originalBounds = clipped.window.Element.prototype.getBoundingClientRect;
    clipped.window.Element.prototype.getBoundingClientRect = function () {
      if (this.id === 'clip') return { top: 0, bottom: 20, left: 0, right: 300, width: 300, height: 20 };
      if (this.tagName === 'ASKGPT-INLINE-TRANSLATION') return { top: 25, bottom: 60, left: 0, right: 300, width: 300, height: 35 };
      return originalBounds.call(this);
    };
    const clipOriginal = clipDocument.querySelector('#clip').outerHTML;
    clipped.start(); await until(() => clipped.calls.length === 1, 'clipped-card request missing');
    await wait(300); assert.equal(clipped.translations().length, 0, 'a clipped translation must be withheld instead of being cut off');
    assert.equal(clipDocument.querySelector('#clip').outerHTML, clipOriginal);
    assert.equal(clipped.calls.length, 1);
    checks.dom_fixed_ancestor_clipping_keeps_original_and_never_partially_renders_or_loops = true;
    for (const axis of ['y', 'x']) {
      const scrolled = fixture(`<main id="viewport" style="overflow-${axis}:hidden"><section id="scrolling" style="overflow-${axis}:auto"><div><p id="offscreen">Offscreen source stays paired when scrolling into view.</p></div></section></main>`);
      const scrollDocument = scrolled.window.document, scrollSource = scrollDocument.querySelector('#offscreen');
      const scrollContainer = scrollDocument.querySelector('#scrolling');
      for (const [name, value] of Object.entries(axis === 'y' ? { clientHeight: 768, scrollHeight: 2000 } : { clientWidth: 768, scrollWidth: 2000 })) {
        Object.defineProperty(scrollContainer, name, { configurable: true, value });
      }
      let offset = 900;
      const baseRect = scrolled.window.Element.prototype.getBoundingClientRect;
      scrolled.window.Element.prototype.getBoundingClientRect = function () {
        if (this.id === 'viewport' || this.id === 'scrolling') return { top: 0, bottom: 768, left: 0, right: 768, width: 768, height: 768 };
        if (this.id === 'offscreen') return axis === 'y' ? { top: offset, bottom: offset + 25, left: 0, right: 300, width: 300, height: 25 } :
          { top: 0, bottom: 25, left: offset, right: offset + 25, width: 25, height: 25 };
        if (this.tagName === 'ASKGPT-INLINE-TRANSLATION') return axis === 'y' ? { top: offset + 30, bottom: offset + 80, left: 0, right: 300, width: 300, height: 50 } :
          { top: 30, bottom: 80, left: offset + 30, right: offset + 80, width: 50, height: 50 };
        return baseRect.call(this);
      };
      scrolled.start(); await until(() => scrolled.calls.length === 1, axis + '-axis offscreen request missing');
      await wait(180); assert.equal(scrolled.translations().length, 1, axis + '-axis outer viewport clipping incorrectly removed a scrollable pair');
      offset = 100; scrolled.window.dispatchEvent(new scrolled.window.Event('scroll'));
      scrollSource.className = 'in-view'; await wait(180);
      assert.equal(scrolled.translations().length, 1); assert.equal(scrolled.calls.length, 1);
      assert.equal(scrollSource.lastElementChild.tagName, 'ASKGPT-INLINE-TRANSLATION');
    }
    checks.dom_outer_viewport_clipping_does_not_drop_offscreen_pairs_inside_horizontal_or_vertical_scrollers = true;
